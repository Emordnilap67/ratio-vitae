<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp">
<LinearLayout android:id="@+id/wi_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/witem" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wi_ic" android:layout_width="26dp" android:layout_height="wrap_content" android:textSize="19sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/wi_v" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/wi_s" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11.5sp" android:textColor="#9AA0C0" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/wi_b" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp"
        android:gravity="center" android:background="@drawable/wtake" android:text="Take all"
        android:textSize="17sp" android:textStyle="bold" android:textColor="#1A0606" android:maxLines="1" />
</LinearLayout>
</FrameLayout>
