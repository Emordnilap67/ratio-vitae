<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp">
<LinearLayout android:id="@+id/wi_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/witem" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_lk" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LEFT NOW" android:textSize="10sp" android:textColor="#9AA0C0" android:letterSpacing="0.15" />
        <TextView android:id="@+id/w_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_tier" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/w_kk" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Account" android:textSize="10sp" android:textColor="#9AA0C0" />
        <TextView android:id="@+id/w_koho" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="after bills" android:textSize="10sp" android:textColor="#9AA0C0" android:layout_marginTop="2dp" />
        <TextView android:id="@+id/w_after" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
