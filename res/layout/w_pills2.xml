<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wbg" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="10dp">
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/w_ph" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Pills" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF8787" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="9.5sp" android:textColor="#6B7090" />
    </LinearLayout>
    <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" android:listSelector="@android:color/transparent"
        android:fadingEdgeLength="14dp" android:requiresFadingEdge="vertical" />
</LinearLayout>
