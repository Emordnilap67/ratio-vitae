<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wbg" android:padding="14dp">
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_ph" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Pills" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF8787" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="9sp" android:textColor="#6B7090" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_i1" android:layout_width="26dp" android:layout_height="wrap_content"
            android:text="☀" android:textSize="19sp" android:textColor="#FFD75F" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/w_n1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/w_s1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/w_t1" android:layout_width="104dp" android:layout_height="36dp"
            android:gravity="center" android:background="@drawable/wtake" android:text="Take all"
            android:textSize="13sp" android:textStyle="bold" android:textColor="#1A0606" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_i2" android:layout_width="26dp" android:layout_height="wrap_content"
            android:text="☾" android:textSize="19sp" android:textColor="#AFAFFF" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/w_n2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/w_s2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/w_t2" android:layout_width="104dp" android:layout_height="36dp"
            android:gravity="center" android:background="@drawable/wtake" android:text="Take all"
            android:textSize="13sp" android:textStyle="bold" android:textColor="#1A0606" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_re" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/w_eo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="26dp" android:layout_height="wrap_content"
                android:text="🥚" android:textSize="17sp" android:gravity="center" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="8dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/w_en" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textStyle="bold" android:textColor="#FFE9A8" android:maxLines="1" />
                <TextView android:id="@+id/w_es" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/w_e1" android:layout_width="54dp" android:layout_height="34dp" android:layout_marginEnd="4dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Ate 1" android:textSize="12sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_e2" android:layout_width="54dp" android:layout_height="34dp" android:layout_marginEnd="4dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Ate 2" android:textSize="12sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_e3" android:layout_width="54dp" android:layout_height="34dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Ate 3" android:textSize="12sp" android:textColor="#FFFFFF" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/w_low" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11.5sp" android:textColor="#FFD75F" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/w_shot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11.5sp" android:textColor="#AFAFFF" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
