<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wbg" android:padding="14dp">
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="top">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_lk" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LEFT NOW" android:textSize="10sp" android:textColor="#9AA0C0" android:letterSpacing="0.15" />
            <TextView android:id="@+id/w_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/w_tier" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="#6B7090" />
            <TextView android:id="@+id/w_kk" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Account" android:textSize="10sp" android:textColor="#9AA0C0" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/w_koho" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="after bills" android:textSize="10sp" android:textColor="#9AA0C0" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/w_after" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#D8D4F0" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="10dp" />
    <TextView android:id="@+id/w_low" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#D8D4F0" android:maxLines="1" android:ellipsize="end" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_b1" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="4dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="− Spent" android:textSize="12.5sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_b2" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="4dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="+ Money in" android:textSize="12.5sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_b3" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="4dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Pay a bill" android:textSize="12.5sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_b4" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:gravity="center" android:background="@drawable/wbtn" android:text="⇪ Import" android:textSize="12.5sp" android:textColor="#FFFFFF" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
