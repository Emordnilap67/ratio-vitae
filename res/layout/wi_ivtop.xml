<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp">
<LinearLayout android:id="@+id/wi_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/whero" android:padding="14dp">
    <TextView android:id="@+id/iv_k" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ALL YOUR INVESTMENTS" android:textSize="10sp" android:textColor="#9AA0C0" android:letterSpacing="0.15" />
    <TextView android:id="@+id/iv_total" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="—" android:textSize="34sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
    <TextView android:id="@+id/iv_ch" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12.5sp" android:textStyle="bold" android:textColor="#4FC38A" android:maxLines="1" android:ellipsize="end" />
    <ImageView android:id="@+id/iv_chart" android:layout_width="match_parent" android:layout_height="78dp"
        android:layout_marginTop="10dp" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:id="@+id/iv_from" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="9.5sp" android:textColor="#6B7090" />
        <TextView android:id="@+id/iv_to" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="9.5sp" android:textColor="#6B7090" />
    </LinearLayout>
    <TextView android:id="@+id/iv_gain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textSize="11.5sp" android:textColor="#4FC38A" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
</FrameLayout>
