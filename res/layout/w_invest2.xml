<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wbg" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="12dp">
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/w_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="9sp" android:textColor="#4FC38A" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/w_ph" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Investments" android:textSize="15sp" android:textStyle="bold" android:letterSpacing="0.03" android:textColor="#4FC38A"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/wchip" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textSize="10sp" android:textColor="#8A90B4" android:maxLines="1" />
        <TextView android:id="@+id/w_cfg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/wchip" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="⇄ account" android:textSize="10.5sp" android:textStyle="bold" android:textColor="#4FC38A" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:id="@+id/w_bar" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:layout_marginTop="10dp" android:layout_marginBottom="8dp"
        android:background="#26FFFFFF" />
    <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" android:listSelector="@android:color/transparent"
        android:fadingEdgeLength="16dp" android:requiresFadingEdge="vertical" />
</LinearLayout>
