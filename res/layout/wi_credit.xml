<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp">
<LinearLayout android:id="@+id/wi_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/witem" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/wic" android:text="📈" android:textSize="17sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/w_ceq_n" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EQUIFAX"
                android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="#9AA0C0" android:maxLines="1" />
            <TextView android:id="@+id/w_ceq" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/w_ceq_s" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_ceq_w" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="#7C82A0" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/w_ctu_n" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRANSUNION"
                android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="#9AA0C0" android:maxLines="1" />
            <TextView android:id="@+id/w_ctu" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/w_ctu_s" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_ctu_w" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="#7C82A0" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_cadd" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp"
        android:gravity="center" android:background="@drawable/wbtn" android:text="+ New score" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
</LinearLayout>
</FrameLayout>
