<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp">
<LinearLayout android:id="@+id/wi_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/witem" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:text="🥚" android:textSize="17sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/w_en" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#FFE9A8" android:maxLines="1" />
            <TextView android:id="@+id/w_es" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_e1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="5dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Ate 1" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_e2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="5dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Ate 2" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_e3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="5dp"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Ate 3" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
        <TextView android:id="@+id/w_e4" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center" android:background="@drawable/wbtn" android:text="Ate 4" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
