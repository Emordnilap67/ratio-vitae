<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp">
<LinearLayout android:id="@+id/wi_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/witem" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="9dp" android:paddingBottom="9dp">
    <TextView android:id="@+id/wi_ic" android:layout_width="26dp" android:layout_height="wrap_content" android:textSize="17sp" android:gravity="center" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
        <TextView android:id="@+id/wi_t" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wi_v" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wi_s" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#9AA0C0" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/wi_b" android:layout_width="wrap_content" android:minWidth="72dp" android:layout_height="38dp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:gravity="center" android:background="@drawable/wbtn" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" android:visibility="gone" />
</LinearLayout>
</FrameLayout>
