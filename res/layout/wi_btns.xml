<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/w_b1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="5dp"
        android:gravity="center" android:background="@drawable/wbtn" android:text="− Spent" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
    <TextView android:id="@+id/w_b2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="5dp"
        android:gravity="center" android:background="@drawable/wbtn" android:text="+ Money in" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
    <TextView android:id="@+id/w_b3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="5dp"
        android:gravity="center" android:background="@drawable/wbtn" android:text="Pay a bill" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
    <TextView android:id="@+id/w_b4" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
        android:gravity="center" android:background="@drawable/wbtn" android:text="⇪ Import" android:textSize="13sp" android:textColor="#FFFFFF" android:maxLines="1" />
</LinearLayout>
</FrameLayout>
